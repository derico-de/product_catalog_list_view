<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="product_catalog_list_view.ProductCatalogListController" t-inherit="web.ListView" t-inherit-mode="primary">
        <xpath expr="//button[hasclass('o_list_button_add')]" position="replace">
            <button t-out="buttonString" type="button" class="btn btn-primary o-kanban-button-back" t-on-click="backToQuotationDebounced"/>
        </xpath>
        <xpath expr="//t[@t-component='props.Renderer']" position="attributes">
            <attribute name="allowSelectors">false</attribute>
        </xpath>
    </t>
</templates>
