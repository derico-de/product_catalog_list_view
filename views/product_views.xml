<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_view_list_catalog" model="ir.ui.view">
        <field name="name">product.view.list.catalog</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <list js_class="product_list_catalog"
                  create="0"
                  edit="0"
                  delete="0"
                  default_order="is_favorite desc, default_code, name, id">
                <field name="is_favorite" widget="boolean_favorite" nolabel="1" readonly="1" optional="show"/>
                <field name="default_code" optional="show"/>
                <field name="name"/>
                <field name="product_template_attribute_value_ids"
                       widget="many2many_tags"
                       groups="product.group_product_variant"
                       optional="show"
                       options="{'color_field': 'color'}"/>
                <field name="categ_id" optional="hide"/>
                <field name="uom_id" groups="uom.group_uom" optional="hide"/>
                <widget name="product_catalog_order_line"/>
            </list>
        </field>
    </record>
</odoo>
